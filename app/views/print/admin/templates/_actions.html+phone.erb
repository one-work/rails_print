<%= button_to({ controller: 'template_tasks', action: 'new', template_id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'plus' %>
  <span><%= t('.template_tasks.new.title') %></span>
<% end %>
<%= link_to({ action: 'show' }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'circle-info' %>
  <span><%= t('.show.title') %></span>
<% end %>
<%= link_to({ controller: 'template_tasks', template_id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'list' %>
  <span><%= t('.template_tasks.index.title') %></span>
<% end %>
<% if current_organ.id == model.organ_id %>
  <%= button_to({ action: 'edit' }, class: 'cell has-column-centered') do %>
    <%= svg_tag 'pencil' %>
    <span><%= t('.edit.title') %></span>
  <% end %>
  <%= button_to({ action: 'destroy' }, method: :delete, class: 'cell has-column-centered') do %>
    <%= svg_tag 'trash' %>
    <span><%= t('.destroy.title') %></span>
  <% end %>
<% end %>
