<div class="as-bar">
  <i class="left"></i>
  <div class="bar-title"><%= t('.title', default: '') %></div>
  <% if @mqtt_printers.present? %>
    <%= button_to({ controller: 'mqtt_printers', action: 'actions', id: @mqtt_printers[0].id }, form: { class: 'right' }) do %>
      <%= svg_tag 'ellipsis-vertical' %>
    <% end %>
  <% else %>
    <i class="right"></i>
  <% end %>
</div>
