<p class="size-7 is-wrap">
  <%= link_to({ controller: 'mqtt_printers', action: 'show', id: model.id }, class: 'tags has-addons') do %>
    <span class="tag <%= model.online ? 'is-primary' : 'is-danger' %>"><%= model.online_i18n %></span>
  <% end %>
</p>
<div data-controller="clipboard" data-action="click->clipboard#copyInner" class="clipboard size-7 is-wrap">
  <div>
    <span>打印任务地址：</span>
    <span data-clipboard-target="source"><%= model.webhook_url %></span>
  </div>
  <%= svg_tag 'clone', class: 'icon ml-1 text-warning copy' %>
</div>
