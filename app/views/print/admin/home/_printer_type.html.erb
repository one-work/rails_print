<div class="content">
  <ol>
    <li>打开纸仓改，更换纸为标签纸！</li>
    <li>关闭纸仓盖！</li>
  </ol>
</div>
<div>
  <% if @printer.dev_type_cpcl? %>
    <%=
      button_to(
        { controller: 'mqtt_printers', action: 'update', id: @printer.id },
        method: :patch,
        params: { 'mqtt_printer[dev_type]': 'esc' },
        class: 'button is-rounded is-primary'
      ) do
    %>
      <%= svg_tag 'print' %>
      <span>切换为 ESC</span>
    <% end %>
  <% else %>
    <%=
      button_to(
        { controller: 'mqtt_printers', action: 'update', id: @printer.id },
        method: :patch,
        params: { 'mqtt_printer[dev_type]': 'cpcl' },
        class: 'button is-rounded is-primary'
      ) do
    %>
      <%= svg_tag 'print' %>
      <span>切换为 CPCL</span>
    <% end %>
  <% end %>
</div>
