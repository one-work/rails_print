<div class="medias as-boxed">
<% @printer_aims.each do |printer_aim| %>
  <%= button_to({ action: 'task' }, params: { printer_id: printer_aim.printer_id, **params.permit(:gid, :aim, :dev_type) }, class: 'media') do %>
    <div class="media-content">
      <p class="is-wrap">
        <span><%= printer_aim.printer.display_name %></span>
        <span class="tag"><%= printer_aim.printer.dev_type_i18n %></span>
      </p>
    </div>
    <div class="media-right">
      <%= svg_tag 'print', class: 'icon is-small is-primary' %>
      <span class="text-grey">选择打印</span>
    </div>
  <% end %>
<% end %>
</div>
