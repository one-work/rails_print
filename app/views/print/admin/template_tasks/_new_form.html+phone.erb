<%= form_with theme: nil, model: @template_task, url: { action: 'create' }, class: 'form-fields as-boxed' do |f| %>
  <%= render 'error_messages', target: f.object if f.object.errors.present? %>
  <div class="form-inline">
    <%= render partial: 'form', locals: { f: f } %>
  </div>
  <%= f.submit nil, class: 'button is-primary' %>
<% end %>
