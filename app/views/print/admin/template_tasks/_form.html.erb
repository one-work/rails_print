<% @template.template_items.order(position: :asc).each do |template_item| %>
  <% if template_item.is_a?(Print::TemplateLine) %>
    <%= f.text_field template_item.code, value: f.object.payload[template_item.code], class: 'input', label: template_item.name %>
  <% elsif template_item.is_a?(Print::TemplateDefault) %>
    <div class="field">
      <span><%= template_item.name %></span>
    </div>
  <% elsif template_item.is_a?(Print::TemplateTable) %>
    <%= f.fields template_item.code, theme: 'fields', model: OpenStruct.new(f.object.payload.fetch(template_item.code, template_item.name_with_blank)) do |ef| %>
      <div class="field is-grouped" data-controller="field" data-field-index-value="<%= ef.index %>">
        <% template_item.name_with_widths.each do |name, _| %>
          <%= ef.text_field name, label: nil, placeholder: name %>
        <% end %>
        <span class="field has-addons has-addons-middle">
          <%= svg_tag 'plus', data: { action: 'click->field#add' }, class: 'icon clickable' %>
          <%= svg_tag 'minus', data: { action: 'click->field#remove' }, class: 'icon clickable' %>
        </span>
      </div>
    <% end %>
  <% end %>
<% end %>
