<%= f.fields :payload, model: OpenStruct.new(f.object.payload) do |ef| %>
  <% @template.template_items.order(position: :asc).each do |template_item| %>
    <% if template_item.is_a?(Print::TemplateLine) %>
      <%= ef.text_field template_item.code, value: f.object.payload[template_item.code], class: 'input', label: template_item.name %>
    <% elsif template_item.is_a?(Print::TemplateDefault) %>
      <p><%= template_item.name %></p>
    <% end %>
  <% end %>
<% end %>
