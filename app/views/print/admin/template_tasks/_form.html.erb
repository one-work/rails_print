<% @template.template_items.order(position: :asc).each do |template_item| %>
  <% if template_item.is_a?(Print::TemplateLine) %>
    <div class="field has-addons">
      <div class="control">
        <%= f.label template_item.code, template_item.name, class: 'button is-static' %>
      </div>
      <div class="control is-expanded">
        <%= f.text_field template_item.code, value: f.object.payload[template_item.code], class: 'input text-right' %>
      </div>
      <% if template_item.unit.present? %>
        <div class="control">
          <div class="button is-static"><%= template_item.unit %></div>
        </div>
      <% end %>
    </div>
  <% elsif template_item.is_a?(Print::TemplateDefault) %>
    <div class="field has-addons">
      <div class="control">
        <div class="button is-static"><%= template_item.name %></div>
      </div>
      <div class="control is-expanded">
        <div class="button is-fullwidth justify-content-flex-end"><%= template_item.value %></div>
      </div>
    </div>
  <% elsif template_item.is_a?(Print::TemplateTable) %>
    <div class="field is-horizontal">
    <% f.object.payload.fetch(template_item.code, [template_item.name_with_blank]).each_with_index do |x, index| %>
      <%= f.fields template_item.code, theme: 'fields', index: nil do |ef| %>
      <div class="field-body mb-3" data-controller="field" data-field-index-value="<%= index %>">
        <% template_item.name_with_widths.each do |name, _| %>
          <%= ef.text_field name, label: nil, placeholder: name, id: nil %>
        <% end %>
        <span class="field has-addons has-addons-middle">
          <%= svg_tag 'plus', data: { action: 'click->field#add' }, class: 'icon clickable' %>
          <%= svg_tag 'minus', data: { action: 'click->field#remove' }, class: 'icon clickable' %>
        </span>
      </div>
      <% end %>
    <% end %>
    </div>
  <% end %>
<% end %>
