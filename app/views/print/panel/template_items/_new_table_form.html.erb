<%= form_with theme: 'modal', model: @template_item, url: { action: 'create' } do |f| %>
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= render 'error_messages', target: f.object if f.object.errors.present? %>
    <div class="form-horizontal">
      <%= f.text_field :name, autofocus: true %>
      <%= f.text_field :code %>
    </div>
  </section>
  <%= f.submit %>
<% end %>
