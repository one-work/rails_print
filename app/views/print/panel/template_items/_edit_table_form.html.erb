<%= form_with theme: 'modal', model: @template_item, url: { action: 'update_table' } do |f| %>
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= render 'error_messages', target: f.object if f.object.errors.present? %>
    <div class="form-horizontal">
      <%= render partial: 'table_form', locals: { f: f } %>
    </div>
  </section>
  <%= f.submit %>
<% end %>
