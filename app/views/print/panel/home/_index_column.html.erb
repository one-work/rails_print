<div class="grid">
  <%= link_to({ controller: 'print/panel/mqtt_users' }, data: { turbo_frame: 'panel', action: 'menu-popup#enter' }, class: active_helper(controllers: ['mqtt_apps'], item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')) do %>
    <span><%= t('print.panel.mqtt_users.index.title') %></span>
  <% end %>
  <%= link_to({ controller: 'print/panel/mqtt_printers' }, data: { turbo_frame: 'panel', action: 'menu-popup#enter' }, class: active_helper(controllers: ['mqtt_printers'], item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')) do %>
    <span><%= t('print.panel.mqtt_printers.index.title') %></span>
  <% end %>
  <%= link_to({ controller: 'print/panel/templates' }, data: { turbo_frame: 'panel', action: 'menu-popup#enter' }, class: active_helper(controllers: ['templates'], item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')) do %>
    <span><%= t('print.panel.templates.index.title') %></span>
  <% end %>
  <%=
    link_to(
      { controller: 'print/panel/tasks', action: 'recent' },
      data: { turbo_frame: 'panel', action: 'menu-popup#enter' },
      class: active_helper(controller: 'print/panel/tasks', action: 'recent', item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')
    ) do
  %>
    <span><%= t('print.panel.tasks.recent.title') %></span>
  <% end %>
</div>
