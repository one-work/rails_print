<div class="box is-padding-less">
  <div class="box-header">
    <span class="size-7 has-border-left-primary">其他</span>
  </div>
  <div class="fixed-grid has-3-cols is-shadow-top p-3">
    <div class="grid">
      <% if request.variant.any?(:mini_program) %>
        <div
          data-controller="mini-program"
          data-mini-program-url-value="/pages/print/index"
          data-mini-program-data-value="<%= { url: url_for(only_path: false) }.to_json %>"
          data-action="click->mini-program#link"
          class="column has-column-centered"
        >
          <div class="text-dark">
            <span><%= '设置打印机' %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
