<%= render 'nav_bar' %>

<div data-controller="print-pos">
  <div data-bridge-bluetooth-target="list" class="p-0 mb-3"></div>
  <div class="box">
    <div class="field">
      <label class="label">蓝牙名称</label>
      <div class="control">
        <input name="name" type="text" placeholder="Name" class="input">
      </div>
    </div>
    <button data-action="click->bridge-bluetooth#setName" class="button is-fullwidth">设置蓝牙名称</button>
  </div>
  <div class="box">
    <div class="field">
      <label class="label">加热时间（数值越大越浓）</label>
      <div data-controller="form" class="control">
        <input name="time" type="number" min="500" max="1500" value="900" placeholder="Name" class="input">
      </div>
    </div>
    <button data-action="click->bridge-bluetooth#setTime" class="button is-fullwidth">设置加热时间</button>
  </div>
</div>
