<div
  data-controller="print-pos"
  class="p-3"
>
  <div data-bridge-bluetooth-target="list" class="p-0 mb-3"></div>
  <div class="box">
    <h1 class="text-centered title is-6">设置 WIFI</h1>
    <div class="field">
      <label class="label">SSID</label>
      <div class="control">
        <input name="ssid" type="text" placeholder="SSID" class="input">
      </div>
    </div>
    <div class="field">
      <label class="label">Password</label>
      <div class="control">
        <input name="password" type="text" placeholder="Password" class="input">
      </div>
    </div>
    <button data-action="click->bridge-bluetooth#setWifi" class="button is-fullwidth">设置 WiFi</button>
  </div>
</div>
